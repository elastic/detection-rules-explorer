{
  "name": "detection-rules-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsc -p tsconfig.scripts.json && node .prebuild/scripts/prebuild/index.js",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@elastic/eui": "^111.1.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "core-js": "^3.48.0",
    "moment": "^2.30.1",
    "next": "^15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-lazy-load": "^4.0.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@next/bundle-analyzer": "^15.5.23",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "axios": "^1.18.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tar": "^7.5.13",
    "toml": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "trim": "1.0.1",
    "prismjs": "^1.30.0",
    "postcss": ">=8.4.31"
  },
  "resolutions": {
    "trim": "1.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
