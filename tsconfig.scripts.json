{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".prebuild",
    "rootDir": ".",
    "strict": true,
    "resolveJsonModule": true
  },
  "include": [
    "./scripts/prebuild/**/*.ts",
    "./src/types/**/*.ts"
  ]
}
